# ---- GeoRisk configuration (copy to .env) --------------------------------
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:3000
# Any http://localhost:<port> is also allowed (CORS_ORIGIN_REGEX). Dashboard port on your machine:
FRONTEND_PORT=3000

# Security. Comma-separated role:key pairs (roles: admin, analyst, viewer).
# With no keys, write endpoints are only allowed when ENVIRONMENT=development.
API_KEYS=
PUBLIC_READ=true

# Monitoring watchlist (ISO3). Ingestion is always global; the watchlist adds
# per-country GDELT DOC news queries.
WATCHLIST=UKR,RUS,ISR,PSE,IRN,SDN,CHN,TWN,IND,PAK,COD,VEN

# Schedules (minutes)
GDELT_EVENTS_INTERVAL_MINUTES=15
GDELT_DOC_INTERVAL_MINUTES=15
PRIORITY_INTERVAL_MINUTES=15
AI_CRISIS_INTERVAL_MINUTES=60

# AI (optional — the platform works without it). none | anthropic | openai
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# UCDP (bulk downloads, no key needed)
UCDP_GED_VERSION=26.1
UCDP_MIN_YEAR=1989

# ACLED (optional, disabled by default; respect ACLED licence terms)
FEATURE_ACLED=false
ACLED_EMAIL=
ACLED_API_KEY=

# Economic Intelligence (planned module)
FEATURE_ECONOMY=false

# Notifications
ALERT_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Separate ML model service (experimental early-warning model)
MODEL_SERVICE_URL=http://localhost:8100
PREDICTIONS_DAY_OF_MONTH=22
